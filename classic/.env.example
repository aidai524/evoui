# Copy to .env.local. Default (nothing set) = fake in-memory mode, full UI flow, no chain.

# ── Wallet / chain
# Real NEAR testnet signing: paste a testnet account + ed25519 key in the wallet menu.
# VITE_NOIR_NEAR=1
# Rhea / NEAR Intents path: reads work, signing fails loud until NoirWallet ships signBusiness.
# VITE_NOIR_INTENTS=1
# VITE_NOIR_FACTORY=tokendeploy.testnet
# VITE_NOIR_RPC=https://rpc.testnet.near.org
# VITE_NOIR_PAYMENT_TOKEN=wrap.testnet
# VITE_NOIR_PAYMENT_SYMBOL=wNEAR
# VITE_NOIR_PAYMENT_DECIMALS=24
# Optional off-chain index of wZEC bot distributions: GET <url>?account_id=&token=
# VITE_NOIR_REWARDS_INDEXER=https://indexer.example/rewards

# ── Curate console
# VITE_CURATE_API=1
# CURATE_API_TARGET=http://localhost:4123
# Server-side only (no VITE_ prefix): the dev proxy adds it as x-api-key.
# TYPESAFE_API_KEY=
